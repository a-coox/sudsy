{
  "extends": ["stylelint-config-standard-scss", "stylelint-config-prettier", "./local.json"],
  "ignoreFiles": ["**/*.min.css"],
  "defaultSeverity": "warning",
  "rules": {
    "block-no-empty": null,
    "color-no-hex": true,
    "color-hex-length": ["long", { "severity": "error" }],
    "selector-class-pattern": ["^[a-z]+$", { "message": "lowercase" }],
    "selector-max-class": 2,
    "property-disallowed-list": [["float", "/^grid/"]],
    "declaration-block-no-duplicate-properties": [true, { "ignore": ["consecutive-duplicates-with-different-values"] }],
    "unit-allowed-list": [["px"], { "ignore": ["custom-properties"] }],
    "function-name-case": "lower",
    "at-rule-no-unknown": true,
    "scss/at-extend-no-missing-placeholder": true,
    "order/properties-order": ["width"]
  },
  "overrides": [{ "files": ["*.scss"], "rules": {} }]
}
