<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built by scripts/parity.sh stylecop in a copy under target/parity/; StyleCopVersion comes from docs/parity/stylecop.yaml. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- StyleCop only sees documentation comments as structured when documentation is generated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="$(StyleCopVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
