# Only the rules Sudsy has an equivalent for (docs/parity/yamllint.yaml), with the parameters
# Sudsy's rules use. Everything else is off so the comparison sees nothing it cannot map.
rules:
  anchors:
    forbid-undeclared-aliases: true
    forbid-duplicated-anchors: true
    forbid-unused-anchors: true
  empty-values:
    forbid-in-block-mappings: true
    forbid-in-flow-mappings: true
    forbid-in-block-sequences: true
  float-values:
    require-numeral-before-decimal: true
    forbid-scientific-notation: true
    forbid-nan: true
    forbid-inf: true
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  quoted-strings:
    quote-type: single
    required: only-when-needed
    extra-required: ["^http://"]
    extra-allowed: ["^x-"]
    allow-quoted-quotes: true
    check-keys: true
  document-start:
    present: true
  key-duplicates:
    forbid-duplicated-merge-keys: true
  key-ordering:
    ignored-keys: ["^_"]
  line-length:
    max: 30
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: true
  braces:
    forbid: true
  brackets:
    forbid: true
  document-end:
    present: true
