{
  "prettier": {
    "catalog": "prettier",
    "install": {"npm": "prettier"},
    "fetch": ["tests/conformance/fetch-markdown-corpus.sh", "tests/conformance/fetch-graphql-corpus.sh"],
    "command": ["node", "{prefix}/node_modules/prettier/bin/prettier.cjs", "--no-config", "--no-editorconfig", "--embedded-language-formatting=off", "{file}"],
    "input": "arg",
    "tool_may_reject": true,
    "fixtures": [
      {"suffixes": [".json", ".jsonc", ".yaml", ".yml", ".md", ".graphql", ".gql"]},
      {"dir": "docs", "suffixes": [".md"], "prefix": "docs/", "recursive": true},
      {"dir": "tests/conformance/corpus/runtime-docs/docs", "suffixes": [".md"], "prefix": "runtime-docs/", "recursive": true},
      {"dir": "tests/conformance/corpus/graphql", "suffixes": [".graphql", ".gql"], "prefix": "graphql/", "recursive": true}
    ]
  },
  "biome": {
    "catalog": "biome",
    "install": {"npm": "@biomejs/biome"},
    "command": ["node", "{prefix}/node_modules/@biomejs/biome/bin/biome", "format", "--stdin-file-path={file}"],
    "input": "stdin",
    "fixtures": [{"suffixes": [".json", ".jsonc", ".yaml", ".yml"]}]
  },
  "taplo": {
    "catalog": "taplo",
    "install": {
      "release": "https://github.com/tamasfe/taplo/releases/download/{version}/{asset}",
      "assets": {
        "windows": "taplo-windows-x86_64.zip",
        "linux-x86_64": "taplo-linux-x86_64.gz",
        "darwin-arm64": "taplo-darwin-aarch64.gz",
        "darwin-x86_64": "taplo-darwin-x86_64.gz"
      },
      "exe": "taplo"
    },
    "fetch": ["tests/conformance/fetch-toml-corpus.sh"],
    "command": ["{exe}", "fmt", "--no-auto-config", "-"],
    "input": "stdin",
    "tool_may_reject": true,
    "fixtures": [
      {"suffixes": [".toml"]},
      {"dir": "tests/fixtures/toml", "suffixes": [".toml"], "prefix": "fixtures/"},
      {"dir": "tests/conformance/corpus/toml-test/tests", "list": "files-toml-1.0.0", "starts": "valid/", "suffixes": [".toml"]}
    ]
  },
  "shfmt": {
    "catalog": "shfmt",
    "install": {
      "release": "https://github.com/mvdan/sh/releases/download/v{version}/{asset}",
      "assets": {
        "windows": "shfmt_v{version}_windows_amd64.exe",
        "linux-x86_64": "shfmt_v{version}_linux_amd64",
        "darwin-arm64": "shfmt_v{version}_darwin_arm64",
        "darwin-x86_64": "shfmt_v{version}_darwin_amd64"
      },
      "exe": "shfmt"
    },
    "fetch": ["tests/conformance/fetch-shell-corpus.sh"],
    "command": ["{exe}", "{file}"],
    "input": "arg",
    "tool_may_reject": true,
    "fixtures": [
      {"suffixes": [".sh"]},
      {"dir": "tests/conformance/corpus/shell", "suffixes": [".sh", ".bash"], "prefix": "corpus/", "recursive": true}
    ]
  },
  "invoke-formatter": {
    "catalog": "psscriptanalyzer",
    "install": {"psmodule": "PSScriptAnalyzer"},
    "fetch": ["tests/conformance/fetch-powershell-corpus.sh"],
    "command": ["pwsh", "-NoProfile", "-File", "{root}/scripts/parity_invoke_formatter.ps1", "{prefix}", "{file}"],
    "input": "arg",
    "tool_may_reject": true,
    "ignore_trailing_blanks": true,
    "fixtures": [
      {"suffixes": [".ps1"]},
      {"dir": "tests/conformance/corpus/powershell", "suffixes": [".ps1", ".psm1"], "prefix": "corpus/", "recursive": true}
    ]
  },
  "buf": {
    "catalog": "buf",
    "install": {
      "release": "https://github.com/bufbuild/buf/releases/download/v{version}/{asset}",
      "assets": {
        "windows": "buf-Windows-x86_64.exe",
        "linux-x86_64": "buf-Linux-x86_64",
        "darwin-arm64": "buf-Darwin-arm64",
        "darwin-x86_64": "buf-Darwin-x86_64"
      },
      "exe": "buf"
    },
    "fetch": ["tests/conformance/fetch-proto-corpus.sh"],
    "command": ["{exe}", "format", "{file}"],
    "input": "arg",
    "tool_may_reject": true,
    "fixtures": [
      {"suffixes": [".proto"]},
      {"dir": "tests/conformance/corpus/proto", "suffixes": [".proto"], "prefix": "corpus/", "recursive": true}
    ]
  },
  "csharpier": {
    "catalog": "csharpier",
    "install": {"dotnet-tool": "csharpier", "exe": "csharpier"},
    "needs": ["worker"],
    "command": ["{exe}", "format", "{file}"],
    "input": "in-place",
    "tool_may_reject": true,
    "fixtures": [{"suffixes": [".cs"]}]
  },
  "csharpier-xml": {
    "catalog": "csharpier",
    "install": {"dotnet-tool": "csharpier", "exe": "csharpier"},
    "fetch": ["tests/conformance/fetch-xml-projects.sh"],
    "command": ["{exe}", "format", "{file}"],
    "input": "in-place",
    "tool_may_reject": true,
    "fixtures": [
      {"suffixes": [".csproj", ".props", ".targets", ".config", ".resx", ".xml", ".slnx", ".xaml"]},
      {"dir": "tests/fixtures/xml", "suffixes": [".csproj", ".props", ".targets", ".config", ".resx", ".xml", ".slnx", ".xaml"], "prefix": "fixtures/"},
      {"dir": "tests/conformance/corpus/xml-projects", "suffixes": [".csproj", ".props", ".targets", ".config", ".resx", ".xml", ".slnx", ".xaml"], "prefix": "corpus/", "recursive": true}
    ]
  },
  "dotnet-format": {
    "version_command": ["dotnet", "--version"],
    "needs": ["worker"],
    "kind": "editorconfig-cases"
  }
}
