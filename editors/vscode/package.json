{
  "name": "sudsy",
  "displayName": "Sudsy",
  "description": "Formatter and linter for source and data files.",
  "version": "0.1.0",
  "publisher": "Coox",
  "icon": "icon.png",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:js",
    "onLanguage:python",
    "onLanguage:css",
    "onLanguage:yaml",
    "onLanguage:dockerfile",
    "onLanguage:editorconfig",
    "onLanguage:gitignore",
    "onLanguage:graphql",
    "onLanguage:hcl",
    "onLanguage:html",
    "onLanguage:ini",
    "onLanguage:makefile",
    "onLanguage:markdown",
    "onLanguage:powershell",
    "onLanguage:protobuf",
    "onLanguage:shell",
    "onLanguage:toml",
    "onLanguage:xml",
    "onLanguage:csharp",
    "workspaceContains:**/sudsy.{yaml,yml}"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "contributes": {
    "yamlValidation": [
      {
        "fileMatch": [
          "sudsy.yaml",
          "sudsy.yml"
        ],
        "url": "./schemas/sudsy.schema.json"
      }
    ],
    "commands": [
      {
        "command": "sudsy.restartServer",
        "title": "Sudsy: Restart Server"
      },
      {
        "command": "sudsy.showOutput",
        "title": "Sudsy: Show Output"
      }
    ],
    "configuration": {
      "title": "Sudsy",
      "properties": {
        "sudsy.serverPath": {
          "type": "string",
          "scope": "machine",
          "description": "Path of the `sudsy` executable (`${workspaceFolder}` is the first workspace folder). Empty: the one bundled with the extension, else `sudsy` from PATH."
        },
        "sudsy.csharpWorkerPath": {
          "type": "string",
          "scope": "machine",
          "description": "Path of `Sudsy.Worker.dll`, the C# worker. Empty: the one next to the executable."
        },
        "sudsy.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between VS Code and the server in the Sudsy output channel."
        }
      }
    }
  },
  "scripts": {
    "prepare-schema": "node scripts/copy-schema.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run prepare-schema && node scripts/build.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "stage-server": "node scripts/stage-server.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
