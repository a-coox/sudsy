<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Sudsy.Worker</AssemblyName>
    <RootNamespace>Sudsy.Worker</RootNamespace>
    <!-- Roslyn's localized messages are never shown: keeps the extension package small. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sudsy.Worker.Tests" />
    <InternalsVisibleTo Include="Sudsy.Bench" />
  </ItemGroup>
</Project>
