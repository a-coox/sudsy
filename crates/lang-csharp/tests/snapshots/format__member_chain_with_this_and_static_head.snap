class C
{
    void M()
    {
        this.builder.WithName("a long name here").WithDescription("another long text here").WithOwner(owner).Build();
        var x = Enumerable.Range(0, 1000000)
            .Where(i => i % 2 == 0)
            .Select(i => i * i)
            .Where(i => i > 100)
            .ToArray()
            .Length;
    }
}
