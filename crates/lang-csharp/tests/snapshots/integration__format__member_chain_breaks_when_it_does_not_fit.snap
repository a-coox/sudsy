class C
{
    void M()
    {
        var a = repository
            .GetAllCustomers()
            .Where(customer => customer.IsActive && customer.Orders.Count > 0)
            .OrderBy(customer => customer.LastName)
            .Select(customer => customer.Name)
            .ToList();
    }
}
