---
source: crates/cli/tests/init.rs
expression: "format!(\"{yaml}---\\n{}\", text(&out.stdout))"
---
# Generated by `sudsy init --from yamllint`; review before use.
extends:
  - preset:yaml/yamllint
yaml:
  format:
    array_bracket_spacing: false
    bracket_spacing: true
    comment_spacing: 1
    final_newline: false
    indent_size: 4
    line_width: 120
    max_blank_lines: 1
    sequence_indent: flush
  lint:
    rules:
      ambiguous-booleans:
        level: warn
        options:
          allowed: ["true", "false", "on"]
          check_keys: false
      document-start: "off"
      float-style: error
      max-line-length:
        level: warn
        options:
          max: 120
      no-duplicate-anchors: error
      no-duplicate-keys:
        level: error
        options:
          merge_keys: forbid
      no-empty-values: error
      no-octal-values: warn
      no-undefined-alias: "off"
      no-unused-anchors: error
      quoted-strings: error
      sorted-keys: error
---
migrated .yamllint.yaml
extends: preset:yaml/yamllint
not migrated: ignore (use `include`/`exclude` globs in sudsy.yaml)
not migrated: colons.max-spaces-after (fixed formatter behavior, not configurable)
not migrated: rules.foo-bar (not a yamllint rule Sudsy knows)
not migrated: line-length.allow-non-breakable-inline-mappings (planned)
not migrated: quoted-strings.quote-type (this setting has no Sudsy option; rule: quoted-strings)
