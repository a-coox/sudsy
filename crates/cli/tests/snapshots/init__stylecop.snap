---
source: crates/cli/tests/init.rs
expression: "format!(\"{yaml}---\\n{}\", text(&out.stdout))"
---
# Generated by `sudsy init --from stylecop`; review before use.
extends:
  - preset:csharp/stylecop
csharp:
  format:
    do_while_line: same_line
    final_newline: true
    indent_size: 4
    indent_style: tab
  lint:
    rules:
      comment-space: "off"
      member-order:
        level: error
        options:
          element_order: [kind, accessibility, constant]
      using-order:
        level: warn
        options:
          system_first: false
---
migrated stylecop.json
extends: preset:csharp/stylecop
