---
source: crates/cli/tests/init.rs
expression: "format!(\"{yaml}---\\n{}\", text(&out.stdout))"
---
# Generated by `sudsy init --from stylelint`; review before use.
extends:
  - preset:css/stylelint-standard
css:
  lint:
    rules:
      at-rule-no-unknown: warn
      block-no-empty: "off"
      color-hex-length:
        level: error
        options:
          style: long
      color-no-hex: warn
      declaration-block-no-duplicate-properties:
        level: warn
        options:
          ignore_consecutive_different_values: true
      function-name-case: warn
      property-disallowed-list:
        level: warn
        options:
          list: [float, "/^grid/"]
      selector-class-pattern:
        level: warn
        options:
          pattern: "^[a-z]+$"
      selector-max-class:
        level: warn
        options:
          max: 2
      unit-allowed-list:
        level: warn
        options:
          list: [px]
exclude: ["**/*.min.css", dist/, "src/vendor/**/*.css"]
---
migrated .stylelintrc.json
extends: preset:css/stylelint-standard
not migrated: stylelint-config-prettier (a shared config is not followed; its rules are not migrated)
not migrated: ./local.json (a shared config is not followed; its rules are not migrated)
not migrated: function-name-case options (Sudsy's rule has no option for them; set them by hand)
not migrated: order/properties-order (not a stylelint rule Sudsy knows)
not migrated: scss/at-extend-no-missing-placeholder (planned)
not migrated: unit-allowed-list options (Sudsy's rule has no option for them; set them by hand)
not migrated: overrides (per-file overrides are not supported; set the rules by hand)
not migrated: !dist/keep.css (negated ignore patterns are not supported)
note: stylelint-config-standard-scss: only the core rules of the preset are included
