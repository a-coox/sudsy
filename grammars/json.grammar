// JSON and JSONC. One grammar covers both dialects: comments and trailing
// commas are representable; whether they are allowed is a parser/rule concern.
// Format: see crates/core-syntax/src/grammar/mod.rs.

language json 1
comments line "//" block "/*" "*/"
suppress disable-next-line "sudsy-disable-next-line"
suppress ignore "sudsy-ignore"
suppress ignore-start "sudsy-ignore-start"
suppress ignore-end "sudsy-ignore-end"

// Trivia. Newline tokens end a line for the trivia attachment rule.
token Whitespace #trivia #whitespace
token Newline #trivia #newline
token LineComment #trivia #comment
token BlockComment #trivia #comment

token LBrace "{" #punctuation
token RBrace "}" #punctuation
token LBracket "[" #punctuation
token RBracket "]" #punctuation
token Colon ":" #punctuation
token Comma "," #punctuation #separator

token String #literal #string
token Number #literal
token True "true" #literal
token False "false" #literal
token Null "null" #literal

// Zero-width end-of-file token; it carries the leading trivia of the file's tail.
token Eof
// Text the lexer could not classify.
token Unknown #error

node Document = value:#value? Eof
node Object #value #block = LBrace members:Member* RBrace
node Member #key-value = key:String Colon value:#value
node Array #value #delimited-list = LBracket elements:#value* RBracket
node Literal #value = value:#literal
