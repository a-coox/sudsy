// HTML, parsed by tree-sitter (tree-sitter-html, forked in grammars/tree-sitter-html) and mapped by the mapping of crates/lang-html/lang.yaml.
// An element is its start tag (`StartTag`), its content and its end tag; void
// elements and elements closed by an implied end tag have no `EndTag`. Text, entities, CDATA sections and
// the text of `<script>`, `<style>`, `<textarea>` and `<title>` are one `Chunk` each (a token inside).
// Format: see crates/core-syntax/src/grammar/mod.rs.

language html 19 "HTML"
comments block "<!--" "-->"
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"
suppress ignore "prettier-ignore"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
token Comment #trivia #comment

token LtBang "<!" #punctuation
token Lt "<" #punctuation
token LtSlash "</" #punctuation
token Gt ">" #punctuation #restyle #tag-end
token SlashGt "/>" #punctuation #restyle #tag-end
token Equals "=" #punctuation
// Vue's `{{ expression }}`.
token LBraceBrace "{{" #punctuation
token RBraceBrace "}}" #punctuation

// `doctype` as written (any case) and what follows it up to `>`.
token DoctypeKw #restyle
token DoctypeBody #restyle
token TagName #restyle
token AttrName #restyle
// Quoted (quotes included) or not.
token AttrValue #restyle

token Text #chunk #restyle
token Entity #chunk
token CData #chunk
// The content of `script`, `style`, `textarea` and `title`: not parsed as markup.
token RawText #chunk #restyle

token Eof
token Unknown #error

node Document = items:#content* Eof
node Doctype #content = LtBang DoctypeKw DoctypeBody Gt
// Svelte: `{expression}` and `{@html x}`, and the tags of its blocks (`{#if x}`, `{:else}`, `{/if}`).
token MustacheText #restyle
token BlockTagText #restyle
node Mustache #content = value:MustacheText
node BlockTag #content = value:BlockTagText
// The tags and the content between them, in order.
node Block #content = items:#content*
node Interpolation #content = LBraceBrace Chunk? RBraceBrace
node Chunk #content = value:#chunk
node Element #content = start:#start-tag content:#content* end:EndTag?
// `>` or `/>`: `<br>` and `<br />` are the same node.
node StartTag #start-tag #mapping = Lt TagName entries:Attribute* #tag-end
// `#transparent`: the formatter writes the end tag of an element that has none, and an element that is
// closed implicitly stays so in the safety check.
node EndTag #transparent = LtSlash TagName Gt
// An end tag that closes no open element.
node StrayEndTag #content = LtSlash TagName Gt
node Attribute #key-value = key:AttrName Equals? value:AttrValue?
