// TOML 1.0, parsed by tree-sitter (tree-sitter-toml-ng) and mapped by the mapping of crates/lang-toml/lang.yaml.
// Format: see crates/core-syntax/src/grammar/mod.rs.

language toml 4 "TOML"
comments line "#"
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
token Comment #trivia #comment

token LBracket "[" #punctuation
token RBracket "]" #punctuation
token LBracket2 "[[" #punctuation
token RBracket2 "]]" #punctuation
token LBrace "{" #punctuation
token RBrace "}" #punctuation
token Equals "=" #punctuation
token Dot "." #punctuation
token Comma "," #punctuation #separator

token BareKey #key-part
token QuotedKey #key-part #string
// A multi-line string may change its line breaks (`end_of_line`): TomlFormatter::extra_check compares the text.
token String #literal #string #restyle
token Integer #literal
token Float #literal
token Boolean #literal
token DateTime #literal

// Zero-width end-of-file token; it carries the leading trivia of the file's tail.
token Eof
// Text the parser could not classify.
token Unknown #error

// Tree-sitter has no node for a one-part key or for a literal: the adapter wraps those tokens.
// Document is a mapping for the pairs before the first table; its tables are not entries.
node Document #mapping = items:#item* Eof
node Table #item #mapping = LBracket key:Key RBracket entries:Pair*
node ArrayTable #item #mapping = LBracket2 key:Key RBracket2 entries:Pair*
node Pair #item #key-value = key:Key Equals value:#value
node Key = parts:#key-part*
node Literal #value = value:#literal
node Array #value #sequence #delimited-list = LBracket elements:#value* RBracket
node InlineTable #value #mapping #delimited-list = LBrace entries:Pair* RBrace
