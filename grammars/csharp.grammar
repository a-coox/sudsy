// C# grammar: one node/token kind per Roslyn SyntaxKind, named after it.
// Node bodies follow Roslyn's Syntax.xml field by field (dotnet/roslyn Syntax.xml, matching
// Microsoft.CodeAnalysis.CSharp 5.9.0) and are matched against the children in order, see
// crates/core-syntax/src/ast.rs. Hand-maintained from here on. Format: see
// crates/core-syntax/src/grammar/mod.rs.
//
// Structured trivia (doc comments, directives) are nodes tagged #trivia whose children are the
// comment's XML or the directive's tokens. Disabled text, whitespace, line comments and
// end-of-line stay trivia tokens. Missing and skipped tokens are ERROR nodes (core kind).

language csharp 2
comments line "//" block "/*" "*/"
suppress disable-next-line "sudsy-disable-next-line"
suppress ignore "sudsy-ignore"
suppress ignore-start "sudsy-ignore-start"
suppress ignore-end "sudsy-ignore-end"

token TildeToken "~" #punctuation #prefix-unary-operator #operator-declaration-operator #operator-member-cref-operator
token ExclamationToken "!" #punctuation #prefix-unary-operator #postfix-unary-operator #operator-declaration-operator #operator-member-cref-operator
token DollarToken "$" #punctuation
token PercentToken "%" #punctuation #binary-operator #operator-declaration-operator #operator-member-cref-operator
token CaretToken "^" #punctuation #prefix-unary-operator #binary-operator #operator-declaration-operator #operator-member-cref-operator
token AmpersandToken "&" #punctuation #prefix-unary-operator #binary-operator #operator-declaration-operator #operator-member-cref-operator
token AsteriskToken "*" #punctuation #prefix-unary-operator #binary-operator #operator-declaration-operator #operator-member-cref-operator
token OpenParenToken "(" #punctuation
token CloseParenToken ")" #punctuation
token MinusToken "-" #punctuation #prefix-unary-operator #binary-operator #operator-declaration-operator #operator-member-cref-operator
token PlusToken "+" #punctuation #prefix-unary-operator #binary-operator #operator-declaration-operator #operator-member-cref-operator
token EqualsToken "=" #punctuation #assignment-operator
token OpenBraceToken "{" #punctuation
token CloseBraceToken "}" #punctuation
token OpenBracketToken "[" #punctuation
token CloseBracketToken "]" #punctuation
token BarToken "|" #punctuation #binary-operator #operator-declaration-operator #operator-member-cref-operator
token BackslashToken "\\" #punctuation
token ColonToken ":" #punctuation
token SemicolonToken ";" #punctuation
token DoubleQuoteToken "\"" #punctuation #xml-text-attribute-start-quote #xml-text-attribute-end-quote #xml-cref-attribute-start-quote #xml-cref-attribute-end-quote #xml-name-attribute-start-quote #xml-name-attribute-end-quote
token SingleQuoteToken "'" #punctuation #xml-text-attribute-start-quote #xml-text-attribute-end-quote #xml-cref-attribute-start-quote #xml-cref-attribute-end-quote #xml-name-attribute-start-quote #xml-name-attribute-end-quote
token LessThanToken "<" #punctuation #binary-operator #relational-pattern-operator #operator-declaration-operator #operator-member-cref-operator
token CommaToken "," #punctuation #separator
token GreaterThanToken ">" #punctuation #binary-operator #relational-pattern-operator #operator-declaration-operator #operator-member-cref-operator
token DotToken "." #punctuation #member-access-operator
token QuestionToken "?" #punctuation
token HashToken "#" #punctuation
token SlashToken "/" #punctuation #binary-operator #operator-declaration-operator #operator-member-cref-operator
token DotDotToken ".." #punctuation
token SlashGreaterThanToken "/>" #punctuation
token LessThanSlashToken "</" #punctuation
token XmlCommentStartToken "<!--"
token XmlCommentEndToken "-->"
token XmlCDataStartToken "<![CDATA["
token XmlCDataEndToken "]]>"
token XmlProcessingInstructionStartToken "<?"
token XmlProcessingInstructionEndToken "?>"
token BarBarToken "||" #punctuation #binary-operator
token AmpersandAmpersandToken "&&" #punctuation #binary-operator
token MinusMinusToken "--" #punctuation #prefix-unary-operator #postfix-unary-operator #operator-declaration-operator #operator-member-cref-operator
token PlusPlusToken "++" #punctuation #prefix-unary-operator #postfix-unary-operator #operator-declaration-operator #operator-member-cref-operator
token ColonColonToken "::" #punctuation
token QuestionQuestionToken "??" #punctuation #binary-operator
token MinusGreaterThanToken "->" #punctuation #member-access-operator
token ExclamationEqualsToken "!=" #punctuation #binary-operator #relational-pattern-operator #operator-declaration-operator #operator-member-cref-operator
token EqualsEqualsToken "==" #punctuation #binary-operator #relational-pattern-operator #operator-declaration-operator #operator-member-cref-operator
token EqualsGreaterThanToken "=>" #punctuation
token LessThanEqualsToken "<=" #punctuation #binary-operator #relational-pattern-operator #operator-declaration-operator #operator-member-cref-operator
token LessThanLessThanToken "<<" #punctuation #binary-operator #operator-declaration-operator #operator-member-cref-operator
token LessThanLessThanEqualsToken "<<=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token GreaterThanEqualsToken ">=" #punctuation #binary-operator #relational-pattern-operator #operator-declaration-operator #operator-member-cref-operator
token GreaterThanGreaterThanToken ">>" #punctuation #binary-operator #operator-declaration-operator #operator-member-cref-operator
token GreaterThanGreaterThanEqualsToken ">>=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token SlashEqualsToken "/=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token AsteriskEqualsToken "*=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token BarEqualsToken "|=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token AmpersandEqualsToken "&=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token PlusEqualsToken "+=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token MinusEqualsToken "-=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token CaretEqualsToken "^=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token PercentEqualsToken "%=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token QuestionQuestionEqualsToken "??=" #punctuation #assignment-operator
token GreaterThanGreaterThanGreaterThanToken ">>>" #punctuation #binary-operator #operator-declaration-operator #operator-member-cref-operator
token GreaterThanGreaterThanGreaterThanEqualsToken ">>>=" #punctuation #assignment-operator #operator-declaration-operator #operator-member-cref-operator
token BoolKeyword "bool" #keyword #predefined-type-keyword
token ByteKeyword "byte" #keyword #predefined-type-keyword
token SByteKeyword "sbyte" #keyword #predefined-type-keyword
token ShortKeyword "short" #keyword #predefined-type-keyword
token UShortKeyword "ushort" #keyword #predefined-type-keyword
token IntKeyword "int" #keyword #predefined-type-keyword
token UIntKeyword "uint" #keyword #predefined-type-keyword
token LongKeyword "long" #keyword #predefined-type-keyword
token ULongKeyword "ulong" #keyword #predefined-type-keyword
token DoubleKeyword "double" #keyword #predefined-type-keyword
token FloatKeyword "float" #keyword #predefined-type-keyword
token DecimalKeyword "decimal" #keyword #predefined-type-keyword
token StringKeyword "string" #keyword #predefined-type-keyword
token CharKeyword "char" #keyword #predefined-type-keyword
token VoidKeyword "void" #keyword #predefined-type-keyword
token ObjectKeyword "object" #keyword #predefined-type-keyword
token TypeOfKeyword "typeof" #keyword
token SizeOfKeyword "sizeof" #keyword
token NullKeyword "null" #keyword #literal-token
token TrueKeyword "true" #keyword #literal-token #operator-declaration-operator #operator-member-cref-operator
token FalseKeyword "false" #keyword #literal-token #operator-declaration-operator #operator-member-cref-operator
token IfKeyword "if" #keyword
token ElseKeyword "else" #keyword
token WhileKeyword "while" #keyword
token ForKeyword "for" #keyword
token ForEachKeyword "foreach" #keyword
token DoKeyword "do" #keyword
token SwitchKeyword "switch" #keyword
token CaseKeyword "case" #keyword #goto-statement-case-or-default-keyword
token DefaultKeyword "default" #keyword #literal-token #goto-statement-case-or-default-keyword #line-directive-trivia-line
token TryKeyword "try" #keyword
token CatchKeyword "catch" #keyword
token FinallyKeyword "finally" #keyword
token LockKeyword "lock" #keyword
token GotoKeyword "goto" #keyword
token BreakKeyword "break" #keyword #yield-statement-return-or-break-keyword
token ContinueKeyword "continue" #keyword
token ReturnKeyword "return" #keyword #yield-statement-return-or-break-keyword #attribute-target
token ThrowKeyword "throw" #keyword
token PublicKeyword "public" #keyword #modifier
token PrivateKeyword "private" #keyword #modifier
token InternalKeyword "internal" #keyword #modifier
token ProtectedKeyword "protected" #keyword #modifier
token StaticKeyword "static" #keyword #modifier
token ReadOnlyKeyword "readonly" #keyword #modifier
token SealedKeyword "sealed" #keyword #modifier
token ConstKeyword "const" #keyword #modifier
token FixedKeyword "fixed" #keyword #modifier
token StackAllocKeyword "stackalloc" #keyword
token VolatileKeyword "volatile" #keyword #modifier
token NewKeyword "new" #keyword #modifier
token OverrideKeyword "override" #keyword #modifier
token AbstractKeyword "abstract" #keyword #modifier
token VirtualKeyword "virtual" #keyword #modifier
token EventKeyword "event" #keyword #attribute-target
token ExternKeyword "extern" #keyword #modifier
token RefKeyword "ref" #keyword #modifier #argument-ref-kind-keyword #cref-parameter-ref-kind-keyword
token OutKeyword "out" #keyword #modifier #argument-ref-kind-keyword #type-parameter-variance-keyword #cref-parameter-ref-kind-keyword
token InKeyword "in" #keyword #modifier #argument-ref-kind-keyword #type-parameter-variance-keyword #cref-parameter-ref-kind-keyword
token IsKeyword "is" #keyword #binary-operator #operator-declaration-operator
token AsKeyword "as" #keyword #binary-operator
token ParamsKeyword "params" #keyword #modifier
token ArgListKeyword "__arglist" #keyword #literal-token #parameter-identifier
token MakeRefKeyword "__makeref" #keyword
token RefTypeKeyword "__reftype" #keyword
token RefValueKeyword "__refvalue" #keyword
token ThisKeyword "this" #keyword #modifier #constructor-initializer-this-or-base-keyword
token BaseKeyword "base" #keyword #constructor-initializer-this-or-base-keyword
token NamespaceKeyword "namespace" #keyword
token UsingKeyword "using" #keyword
token ClassKeyword "class" #keyword #record-declaration-class-or-struct-keyword #class-or-struct-constraint-class-or-struct-keyword
token StructKeyword "struct" #keyword #record-declaration-class-or-struct-keyword #class-or-struct-constraint-class-or-struct-keyword
token InterfaceKeyword "interface" #keyword
token EnumKeyword "enum" #keyword
token DelegateKeyword "delegate" #keyword
token CheckedKeyword "checked" #keyword #checked-keyword #checked-statement-keyword
token UncheckedKeyword "unchecked" #keyword #checked-keyword #checked-statement-keyword
token UnsafeKeyword "unsafe" #keyword #modifier
token OperatorKeyword "operator" #keyword
token ExplicitKeyword "explicit" #keyword #conversion-operator-declaration-implicit-or-explicit-keyword #conversion-operator-member-cref-implicit-or-explicit-keyword
token ImplicitKeyword "implicit" #keyword #conversion-operator-declaration-implicit-or-explicit-keyword #conversion-operator-member-cref-implicit-or-explicit-keyword
token YieldKeyword "yield" #keyword
token PartialKeyword "partial" #keyword #modifier
token AliasKeyword "alias" #keyword
token GlobalKeyword "global" #keyword #name-identifier
token AssemblyKeyword "assembly" #keyword #attribute-target
token ModuleKeyword "module" #keyword #attribute-target
token TypeKeyword "type" #keyword #attribute-target
token FieldKeyword "field" #keyword #attribute-target
token MethodKeyword "method" #keyword #attribute-target
token ParamKeyword "param" #keyword #attribute-target
token PropertyKeyword "property" #keyword #attribute-target
token TypeVarKeyword "typevar" #keyword #attribute-target
token GetKeyword "get" #keyword #accessor-declaration-keyword
token SetKeyword "set" #keyword #accessor-declaration-keyword
token AddKeyword "add" #keyword #accessor-declaration-keyword
token RemoveKeyword "remove" #keyword #accessor-declaration-keyword
token WhereKeyword "where" #keyword
token FromKeyword "from" #keyword
token GroupKeyword "group" #keyword
token JoinKeyword "join" #keyword
token IntoKeyword "into" #keyword
token LetKeyword "let" #keyword
token ByKeyword "by" #keyword
token SelectKeyword "select" #keyword
token OrderByKeyword "orderby" #keyword
token OnKeyword "on" #keyword
token EqualsKeyword "equals" #keyword
token AscendingKeyword "ascending" #keyword #ordering-ascending-or-descending-keyword
token DescendingKeyword "descending" #keyword #ordering-ascending-or-descending-keyword
token NameOfKeyword "nameof" #keyword
token AsyncKeyword "async" #keyword #modifier
token AwaitKeyword "await" #keyword
token WhenKeyword "when" #keyword
token OrKeyword "or" #keyword #binary-pattern-operator
token AndKeyword "and" #keyword #binary-pattern-operator
token NotKeyword "not" #keyword
token WithKeyword "with" #keyword
token InitKeyword "init" #keyword #accessor-declaration-keyword
token RecordKeyword "record" #keyword
token ManagedKeyword "managed" #keyword #function-pointer-calling-convention-managed-or-unmanaged-keyword
token UnmanagedKeyword "unmanaged" #keyword #function-pointer-calling-convention-managed-or-unmanaged-keyword
token RequiredKeyword "required" #keyword #modifier
token ScopedKeyword "scoped" #keyword #modifier
token FileKeyword "file" #keyword #modifier
token AllowsKeyword "allows" #keyword
token ExtensionKeyword "extension" #keyword
token UnionKeyword "union" #keyword
token ClosedKeyword "closed" #keyword #modifier
token SafeKeyword "safe" #keyword
token ElifKeyword "elif" #keyword
token EndIfKeyword "endif" #keyword
token RegionKeyword "region" #keyword
token EndRegionKeyword "endregion" #keyword
token DefineKeyword "define" #keyword
token UndefKeyword "undef" #keyword
token WarningKeyword "warning" #keyword
token ErrorKeyword "error" #keyword
token LineKeyword "line" #keyword
token PragmaKeyword "pragma" #keyword
token HiddenKeyword "hidden" #keyword #line-directive-trivia-line
token ChecksumKeyword "checksum" #keyword
token DisableKeyword "disable" #keyword #pragma-warning-directive-trivia-disable-or-restore-keyword #nullable-directive-trivia-setting
token RestoreKeyword "restore" #keyword #pragma-warning-directive-trivia-disable-or-restore-keyword #nullable-directive-trivia-setting
token ReferenceKeyword "r" #keyword
token InterpolatedStringStartToken "$\"" #interpolated-string-string-start
token InterpolatedStringEndToken "\"" #interpolated-string-string-end
token InterpolatedVerbatimStringStartToken "$@\"" #interpolated-string-string-start
token LoadKeyword "load" #keyword
token NullableKeyword "nullable" #keyword
token EnableKeyword "enable" #keyword #nullable-directive-trivia-setting
token WarningsKeyword "warnings" #keyword #nullable-directive-trivia-target
token AnnotationsKeyword "annotations" #keyword #nullable-directive-trivia-target
token VarKeyword "var" #keyword
token UnderscoreToken "_" #punctuation
token OmittedTypeArgumentToken
token OmittedArraySizeExpressionToken
token EndOfDirectiveToken
token EndOfDocumentationCommentToken
token EndOfFileToken
token BadToken #error
token IdentifierToken #identifier #name-identifier #attribute-target #accessor-declaration-keyword #parameter-identifier
token NumericLiteralToken #literal #literal-token #line-directive-trivia-line
token CharacterLiteralToken #literal #literal-token
token StringLiteralToken #literal #string #literal-token
token XmlEntityLiteralToken #literal #xml-text-token
token XmlTextLiteralToken #literal #xml-text-token
token XmlTextLiteralNewLineToken #xml-text-token
token InterpolatedStringToken
token InterpolatedStringTextToken #literal #string
token SingleLineRawStringLiteralToken #literal #string #literal-token
token MultiLineRawStringLiteralToken #literal #string #literal-token
token Utf8StringLiteralToken #literal #string #literal-token
token Utf8SingleLineRawStringLiteralToken #literal #string #literal-token
token Utf8MultiLineRawStringLiteralToken #literal #string #literal-token
token RazorContentToken #punctuation
token EndOfLineTrivia #trivia #newline
token WhitespaceTrivia #trivia #whitespace
token SingleLineCommentTrivia #trivia #comment
token MultiLineCommentTrivia #trivia #comment
token DocumentationCommentExteriorTrivia #trivia #comment #documentation
token DisabledTextTrivia #trivia #disabled-text #verbatim-trivia
token PreprocessingMessageTrivia #trivia
token ConflictMarkerTrivia #trivia #verbatim-trivia
token InterpolatedSingleLineRawStringStartToken #interpolated-string-string-start
token InterpolatedMultiLineRawStringStartToken #interpolated-string-string-start
token InterpolatedRawStringEndToken #interpolated-string-string-end

node IdentifierName #simple-name #name #type #expression =
    identifier:#name-identifier
node QualifiedName #name #type #expression =
    left:#name dot:DotToken right:#simple-name
node GenericName #simple-name #name #type #expression =
    identifier:IdentifierToken type_argument_list:TypeArgumentList
node TypeArgumentList #delimited-list =
    less_than:LessThanToken arguments:#type* greater_than:GreaterThanToken
node AliasQualifiedName #name #type #expression =
    alias:IdentifierName colon_colon:ColonColonToken name:#simple-name
node PredefinedType #type #expression =
    keyword:#predefined-type-keyword
node ArrayType #type #expression =
    element_type:#type rank_specifiers:ArrayRankSpecifier*
node ArrayRankSpecifier #delimited-list =
    open_bracket:OpenBracketToken sizes:#expression* close_bracket:CloseBracketToken
node PointerType #type #expression =
    element_type:#type asterisk:AsteriskToken
node FunctionPointerType #type #expression =
    delegate_keyword:DelegateKeyword asterisk:AsteriskToken calling_convention:FunctionPointerCallingConvention? parameter_list:FunctionPointerParameterList
node FunctionPointerParameterList #delimited-list =
    less_than:LessThanToken parameters:FunctionPointerParameter* greater_than:GreaterThanToken
node FunctionPointerCallingConvention =
    managed_or_unmanaged_keyword:#function-pointer-calling-convention-managed-or-unmanaged-keyword unmanaged_calling_convention_list:FunctionPointerUnmanagedCallingConventionList?
node FunctionPointerUnmanagedCallingConventionList #delimited-list =
    open_bracket:OpenBracketToken calling_conventions:FunctionPointerUnmanagedCallingConvention* close_bracket:CloseBracketToken
node FunctionPointerUnmanagedCallingConvention =
    name:IdentifierToken
node NullableType #type #expression =
    element_type:#type question:QuestionToken
node TupleType #type #expression #delimited-list =
    open_paren:OpenParenToken elements:TupleElement* close_paren:CloseParenToken
node TupleElement =
    type:#type identifier:IdentifierToken?
node OmittedTypeArgument #type #expression =
    omitted_type_argument:OmittedTypeArgumentToken
node RefType #type #expression =
    ref_keyword:RefKeyword read_only_keyword:ReadOnlyKeyword? type:#type
node ScopedType #type #expression =
    scoped_keyword:ScopedKeyword type:#type
node ParenthesizedExpression #expression =
    open_paren:OpenParenToken expression:#expression close_paren:CloseParenToken
node TupleExpression #expression #delimited-list =
    open_paren:OpenParenToken arguments:Argument* close_paren:CloseParenToken
node UnaryPlusExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node UnaryMinusExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node BitwiseNotExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node LogicalNotExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node PreIncrementExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node PreDecrementExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node AddressOfExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node PointerIndirectionExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node IndexExpression #expression =
    operator:#prefix-unary-operator operand:#expression
node AwaitExpression #expression =
    await_keyword:AwaitKeyword expression:#expression
node PostIncrementExpression #expression =
    operand:#expression operator:#postfix-unary-operator
node PostDecrementExpression #expression =
    operand:#expression operator:#postfix-unary-operator
node SuppressNullableWarningExpression #expression #member-chain =
    operand:#expression operator:#postfix-unary-operator
node SimpleMemberAccessExpression #expression #member-chain =
    expression:#expression operator:#member-access-operator name:#simple-name
node PointerMemberAccessExpression #expression =
    expression:#expression operator:#member-access-operator name:#simple-name
node ConditionalAccessExpression #expression #member-chain =
    expression:#expression operator:QuestionToken when_not_null:#expression
node MemberBindingExpression #expression #member-chain =
    operator:DotToken name:#simple-name
node ElementBindingExpression #expression #member-chain =
    argument_list:BracketedArgumentList
node RangeExpression #expression =
    left_operand:#expression? operator:DotDotToken right_operand:#expression?
node ImplicitElementAccess #expression =
    argument_list:BracketedArgumentList
node AddExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node SubtractExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node MultiplyExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node DivideExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node ModuloExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node LeftShiftExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node RightShiftExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node UnsignedRightShiftExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node LogicalOrExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node LogicalAndExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node BitwiseOrExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node BitwiseAndExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node ExclusiveOrExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node EqualsExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node NotEqualsExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node LessThanExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node LessThanOrEqualExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node GreaterThanExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node GreaterThanOrEqualExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node IsExpression #expression =
    left:#expression operator:#binary-operator right:#expression
node AsExpression #expression =
    left:#expression operator:#binary-operator right:#expression
node CoalesceExpression #expression #binary-chain =
    left:#expression operator:#binary-operator right:#expression
node SimpleAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node AddAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node SubtractAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node MultiplyAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node DivideAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node ModuloAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node AndAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node ExclusiveOrAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node OrAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node LeftShiftAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node RightShiftAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node UnsignedRightShiftAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node CoalesceAssignmentExpression #expression #assignment =
    left:#expression operator:#assignment-operator right:#expression
node ConditionalExpression #expression =
    condition:#expression question:QuestionToken when_true:#expression colon:ColonToken when_false:#expression
node ThisExpression #expression =
    token:ThisKeyword
node BaseExpression #expression =
    token:BaseKeyword
node ArgListExpression #expression =
    token:#literal-token
node NumericLiteralExpression #expression =
    token:#literal-token
node StringLiteralExpression #expression #string =
    token:#literal-token
node Utf8StringLiteralExpression #expression #string =
    token:#literal-token
node CharacterLiteralExpression #expression =
    token:#literal-token
node TrueLiteralExpression #expression =
    token:#literal-token
node FalseLiteralExpression #expression =
    token:#literal-token
node NullLiteralExpression #expression =
    token:#literal-token
node DefaultLiteralExpression #expression =
    token:#literal-token
node FieldExpression #expression =
    token:FieldKeyword
node MakeRefExpression #expression =
    keyword:MakeRefKeyword open_paren:OpenParenToken expression:#expression close_paren:CloseParenToken
node RefTypeExpression #expression =
    keyword:RefTypeKeyword open_paren:OpenParenToken expression:#expression close_paren:CloseParenToken
node RefValueExpression #expression =
    keyword:RefValueKeyword open_paren:OpenParenToken expression:#expression comma:CommaToken type:#type close_paren:CloseParenToken
node CheckedExpression #expression =
    keyword:#checked-keyword open_paren:OpenParenToken expression:#expression close_paren:CloseParenToken
node UncheckedExpression #expression =
    keyword:#checked-keyword open_paren:OpenParenToken expression:#expression close_paren:CloseParenToken
node UnsafeExpression #expression =
    keyword:UnsafeKeyword open_paren:OpenParenToken expression:#expression close_paren:CloseParenToken
node DefaultExpression #expression =
    keyword:DefaultKeyword open_paren:OpenParenToken type:#type close_paren:CloseParenToken
node TypeOfExpression #expression =
    keyword:TypeOfKeyword open_paren:OpenParenToken type:#type close_paren:CloseParenToken
node SizeOfExpression #expression =
    keyword:SizeOfKeyword open_paren:OpenParenToken type:#type close_paren:CloseParenToken
node InvocationExpression #expression #member-chain =
    expression:#expression argument_list:ArgumentList
node ElementAccessExpression #expression #member-chain =
    expression:#expression argument_list:BracketedArgumentList
node ArgumentList #delimited-list =
    open_paren:OpenParenToken arguments:Argument* close_paren:CloseParenToken
node BracketedArgumentList #delimited-list =
